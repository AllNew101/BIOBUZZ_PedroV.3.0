Command name... = Command.build()
    .setStart(() -> {}) ## like init that need to set the value before starting
    .setExecute(() -> {}) ## the worker that when .setStart finish it start to working
    .setDone(() -> {}) ## check that the work is done or not if already done sent the data to .setEnd
    .setEnd(endCondition -> {}) ## wait until .setDone sent then stop this command

    #### Use or not its ok ####
    .requiring(/* requirements */)
